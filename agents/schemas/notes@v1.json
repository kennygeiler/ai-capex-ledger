{
  "$comment": "Output contract for one notes task: segment capex and revenue, PP&E by category, finance lease liabilities, purchase commitments, each a cited cell.",
  "type": "object",
  "required": ["accession", "prompt_version", "values", "not_found"],
  "properties": {
    "accession": {"type": "string"},
    "prompt_version": {"type": "string", "const": "notes@v1"},
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "dimension", "table_id", "row_label", "column_label", "cell_text", "period_end", "months", "value", "confidence"],
        "properties": {
          "field": {"enum": ["segment_capex", "segment_revenue", "ppe_category", "finance_lease_liability", "purchase_commitments"]},
          "dimension": {"type": ["string", "null"]},
          "table_id": {"type": "string"},
          "row_label": {"type": "string"},
          "column_label": {"type": "string"},
          "cell_text": {"type": "string"},
          "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "months": {"enum": [0, 12]},
          "value": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "not_found": {"type": "array", "items": {"type": "object", "required": ["field", "reason"]}}
  }
}
