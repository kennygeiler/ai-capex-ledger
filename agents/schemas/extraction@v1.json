{
  "$comment": "Output contract for one extraction task. One JSON object per task.",
  "type": "object",
  "required": ["accession", "prompt_version", "values", "not_found"],
  "properties": {
    "accession": {"type": "string"},
    "prompt_version": {"type": "string", "const": "statements@v1"},
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "table_id", "row_label", "column_label", "cell_text", "period_end", "months", "value", "confidence"],
        "properties": {
          "field": {"enum": ["revenue", "cost_of_revenue", "operating_income", "capex"]},
          "table_id": {"type": "string"},
          "row_label": {"type": "string"},
          "column_label": {"type": "string"},
          "cell_text": {"type": "string"},
          "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "months": {"enum": [3, 6, 9, 12]},
          "value": {"type": "integer"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "not_found": {
      "type": "array",
      "items": {"type": "object", "required": ["field", "reason"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}}
    }
  }
}
